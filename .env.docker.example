# Copy to .env next to docker-compose.yml. Never commit real values.
# Generate secrets with: openssl rand -base64 24 | tr -d '/+='

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# The URL you type in the browser; links in emails are built from it. Cookies are only marked
# Secure when it starts with https://, so plain http works on a home network.
# Home network example: APP_URL=http://192.168.0.121:1314 with APP_BIND=0.0.0.0 and APP_PORT=1314.
APP_URL=http://localhost:3000

# Host interface / port the app is published on. Default is this machine only (127.0.0.1:3000).
# Use 0.0.0.0 to reach it from other devices (plain http: trusted networks only).
# APP_BIND=127.0.0.1
# APP_PORT=3000

# Reverse proxies in front of the app that append to X-Forwarded-For. 0 = none (app published
# directly), 1 = one proxy such as Caddy or nginx.
TRUSTED_PROXY_HOPS=0

REQUIRE_EMAIL_VERIFICATION=false

# SMTP. If SMTP_HOST is empty, emails are printed to the app log (docker compose logs app).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WalletHistory <noreply@example.com>"
