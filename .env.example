# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string (Supabase pooler or direct). Server-side only.
DATABASE_URL=

# Max connections in the Postgres client pool (default 10). On serverless, keep it small and use
# the Supabase pooler URL.
DATABASE_POOL_MAX=10

# Redis over TCP, e.g. redis://default:password@host:6379 (rediss:// for TLS). Leave empty to run
# without a cache: every read then goes to the database.
REDIS_URL=

# Public base URL of the app, used to build links in emails and redirects.
APP_URL=http://localhost:3000

# Reverse proxies in front of the app that append to X-Forwarded-For (default 1: Vercel, Fly,
# a single load balancer). The client IP is taken that many entries from the right, because the
# left side is client-controlled. 0 = ignore the header (no IP in the login log, no per-IP limits).
TRUSTED_PROXY_HOPS=1

# "self-hosted" (default) or "hosted". Read once at startup; nothing branches on it yet.
DEPLOYMENT_MODE=self-hosted

# true = users must verify their email before they get a session.
REQUIRE_EMAIL_VERIFICATION=false

# SMTP. If SMTP_HOST is empty, emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false      # true for port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WalletHistory <noreply@example.com>"

# Tests only: a DISPOSABLE Postgres database used by integration/E2E tests.
# Never point this at the dev or seeded database; tests wipe data.
DATABASE_URL_TEST=
